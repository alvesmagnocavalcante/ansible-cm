# Copie este arquivo para .env e preencha somente no servidor.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mesmo mapeamento do monitor-telegram-cm. Vazio envia direto ao chat.
# Valores: Taiba, charme, Magna, acaraizinho ou wind.
TELEGRAM_TOPIC=
TELEGRAM_TOPIC_TAIBA_ID=
TELEGRAM_TOPIC_CHARME_ID=
TELEGRAM_TOPIC_MAGNA_ID=
TELEGRAM_TOPIC_ACARAIZINHO_ID=
TELEGRAM_TOPIC_WIND_ID=

# Alternativa do guia Python: ID direto, sem selecionar TELEGRAM_TOPIC.
TELEGRAM_TOPIC_ID=

# Configuracao exclusiva do IFC8; nao monitora CPU/RAM/disco.
MONITOR_INTERVAL=30s
ALERT_REPEAT_INTERVAL=5m
IFC_CONFIG_PATH=C:\Fidelio\Ifc8.Net\IfcApplication\SPH\Ifc8NetConfigSPH.Xml
IFC_LOG_PATH=C:\Fidelio\Ifc8.Net\IfcApplication\SPH\M87POS_SPH_Log.evt
IFC_LOG_MAX_AGE=0s
